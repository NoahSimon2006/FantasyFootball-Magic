# Copy this file to api/.env and put real values there. api/.env is never committed.
# Every setting has a working default for local development, so .env is optional for now.

# Postgres connection. Default: the Docker database from docker-compose.yml.
# Use 127.0.0.1, not "localhost" (see the comment in app/config.py).
DATABASE_URL=postgresql+psycopg://fantasy:fantasy@127.0.0.1:5432/fantasy_magic?connect_timeout=10

# Coming with the league crawler: comma-separated Sleeper usernames to start crawling from.
# SLEEPER_SEED_USERNAMES=your_sleeper_username

# Coming with the AI trade advisor: a Claude API key from https://platform.claude.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
