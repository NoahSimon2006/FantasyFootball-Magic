# Copy this file to api/.env and put real values there. api/.env is never committed.
# Every setting has a working default for local development, so .env is optional for now.

# Postgres connection. Default: the Docker database from docker-compose.yml.
# Use 127.0.0.1, not "localhost" (see the comment in app/config.py).
DATABASE_URL=postgresql+psycopg://fantasy:fantasy@127.0.0.1:5432/fantasy_magic?connect_timeout=10

# Comma-separated Sleeper usernames the league crawler starts from (`python -m app.ingest seed`).
# SLEEPER_SEED_USERNAMES=your_sleeper_username

# Ceiling on Sleeper API calls per minute (Sleeper asks clients to stay under 1000).
# SLEEPER_MAX_REQUESTS_PER_MINUTE=600

# Where the daily ~15 MB players download is cached (relative to api/; gitignored).
# CACHE_DIR=.cache

# AI trade advisor: a Claude API key from https://platform.claude.com/settings/keys.
# Without one the advisor endpoint answers 503 and everything else works as usual.
# ANTHROPIC_API_KEY=sk-ant-...
# ADVISOR_MODEL=claude-sonnet-5-5
# ADVISOR_MAX_REQUESTS_PER_HOUR=20
